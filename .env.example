# Use a NEW database for this app (a new Neon project or branch), not the one from the old app.
DATABASE_URL=
DIRECT_URL=

# At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the screens are served from (for cross-site requests). Leave empty in development.
FRONTEND_URL=
PORT=4000

# The NRS signing key shared by companies that have none of their own: the whole crypto_keys.txt on one line.
# (A company's own keys, entered on the Companies page, are used first.)
# NRS_CRYPTO_KEYS=
# ...or its two parts:
# NRS_PUBLIC_KEY=
# NRS_CERTIFICATE=

# The public https address of this backend. Needed for the QuickBooks Desktop setup file (.qwc):
# QuickBooks Web Connector calls <PUBLIC_BASE_URL>/qbwc and only accepts https (or http://localhost for a trial).
# PUBLIC_BASE_URL=
